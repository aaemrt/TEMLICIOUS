body{
    margin: 0px;
}
header{
    display: flex;
    top: 0;
    width: 100%;
    background-color:#2b3663;
    justify-content: space-between;
    position: fixed;
    align-items: center;
    z-index: 1;
    color: white;
    padding: 10px;
}
nav a{
    padding: 10px 25px;
    font-size: large;
    text-decoration: none;
    color: white;
    
}
section.home{
    background: url(tampak\ depan.jpg);
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment:fixed;
    padding-top:100px;
    height: 600px;
}
section.home div{
    text-align: center;
    color: white;
    margin: auto;
    width: 70%;
    padding: 20px;
}
section.home .welcome{
    font-size: 30px;
}
section.home a{
    color: white;
    padding: 10px 20px;
    text-decoration: none;
    box-shadow: 0px 0px 3px;
    border-radius: 20px;
}
section.about{
    background-color: #939fcf;
    height: 600px;
    padding-top:100px;
}
section.about div{
    color: white;
    text-align: center;
    margin: auto;
    width:70;
}
section.about img{
    height:200px;
}
section.product{
    background: url(tampak\ dalam.jpg);
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    height: 600px;
}
section.product.container{
    justify-content:center;
    display: flex;
    flex-wrap: wrap;
    padding-top: 50px;
}
section.product.container.card{
    background-color:white;
    text-align: center;
    padding: 5px;
    width: 200px;
    height: 400px;
    margin: 15px;
}
section.product.container.card img{
    width:100%;
}
section.product.container.card a{
    color:black;
    padding: 5px 20px;
    text-decoration:none;
    box-shadow:0px 0px 3px;
    border-radius:20px;
}
section.contact{
    background-color: #ebeefa;
    height: 600px;
}
footer{
    background-color: black;
    height: 50px;
}